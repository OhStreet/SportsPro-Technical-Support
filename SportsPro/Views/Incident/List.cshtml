@model IncidentListViewModel
@{
	ViewData["Title"] = "Incident Manager";
}

<h1>Incident Manager</h1>

@* Determine the current filter *@
@{
	string current = Model.IncidentStatus ?? "all";
}


@* Navigation pills for filtering incidents *@
<ul class="nav nav-pills mb-3">
	<li class="nav-item">
		<a class="nav-link @(current == "all" ? "active" : "")"
		   asp-action="List"
		   asp-route-incidentStatus="all">
			All
		</a>
	</li>

	<li class="nav-item">
		<a class="nav-link @(current == "unassigned" ? "active" : "")"
		   asp-action="List"
		   asp-route-incidentStatus="unassigned">
			Unassigned
		</a>
	</li>

	<li class="nav-item">
		<a class="nav-link @(current == "open" ? "active" : "")"
		   asp-action="List"
		   asp-route-incidentStatus="open">
			Open
		</a>
	</li>
</ul>

@* Table to display incidents *@
<table class="table table-striped table-bordered">
	<thead>
		<tr>
			<th>Title</th>
			<th>Customer</th>
			<th>Product</th>
			<th>Date Opened</th>
		</tr>
	</thead>
	<tbody>

		@* Using ViewModel to display incidents *@
		@foreach (Incident incident in Model.Incidents)
		{
			<tr>
				<td>@incident.Title</td>
				<td>@incident.Customer?.FullName</td>
				<td>@incident.Product?.Name</td>
				<td>@incident.DateOpened.ToShortDateString()</td>
				<td>
					<a class="btn btn-primary" asp-controller="Incident" asp-action="Edit"
					   asp-route-id="@incident.IncidentID">Edit</a>
				</td>
				<td>
					<a class="btn btn-primary" asp-controller="Incident" asp-action="Delete"
					   asp-route-id="@incident.IncidentID">Delete</a>
				</td>
			</tr>
		}
	</tbody>
</table>
<a asp-controller="Incident" asp-action="Add" class="btn btn-primary">Add Incident</a>
