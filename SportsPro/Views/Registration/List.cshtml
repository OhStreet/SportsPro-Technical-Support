@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Registrations";
    var customer = ViewBag.Customer as SportsPro.Models.Customer;
    var registrations = ViewBag.Registrations as IEnumerable<SportsPro.Models.Registration>;
    var allProducts = ViewBag.AllProducts as IEnumerable<SportsPro.Models.Product>;
}

<h1>Registrations</h1>
<h3>Customer: @customer?.FullName</h3>

@if (registrations == null || !registrations.Any())
{
    <p>No products are registered for this customer.</p>
}
else
{
    <table class="table table-striped table-bordered mb-3">
        <thead>
            <tr>
                <th>Product</th>
                <th>Code</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var reg in registrations)
            {
                <tr>
                    <td>@reg.Product.Name</td>
                    <td>@reg.Product.ProductCode</td>
                </tr>
            }
        </tbody>
    </table>
}

<hr />
<h4>Register a Product</h4>
<form asp-action="Register" method="post">
    <div class="mb-3">
        <label class="form-label">Product</label>
        <select name="productId" class="form-select">
            <option value="0">-- Select a product --</option>
            @foreach (var product in allProducts)
            {
                <option value="@product.ProductID">@product.Name</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Register</button>
</form>

<a asp-action="SwitchCustomer" class="btn btn-secondary mt-3">Switch Customer</a>
